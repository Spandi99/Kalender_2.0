# -------- BUILD STAGE --------
FROM node:18-alpine AS build
WORKDIR /app

# 1. Dependencies installieren
COPY package*.json ./
RUN npm install --legacy-peer-deps

# 2. Restlichen Code kopieren
COPY . .

# 3. Sicherstellen, dass FullCalendar-CSS existiert
RUN mkdir -p node_modules/@fullcalendar/daygrid \
    && mkdir -p node_modules/@fullcalendar/timegrid \
    && mkdir -p node_modules/@fullcalendar/list \
    && echo "/* autogenerated fallback */" > node_modules/@fullcalendar/daygrid/main.css \
    && echo "/* autogenerated fallback */" > node_modules/@fullcalendar/timegrid/main.css \
    && echo "/* autogenerated fallback */" > node_modules/@fullcalendar/list/main.css

# 4. Build durchführen
RUN npm run build

# -------- PRODUCTION STAGE --------
FROM nginx:stable-alpine
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
